{
  "name": "@hawiyat-org/pi-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Hawiyat pi extensions: Hawiyat model provider, pi-stats usage reporting, interactive subagents, and web fetch.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extensions",
    "hawiyat"
  ],
  "pi": {
    "extensions": [
      "./extensions/hawiyat-provider/index.ts",
      "./extensions/pi-stats/index.ts",
      "./extensions/web-fetch/index.ts",
      "./extensions/subagents/index.ts"
    ]
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "linkedom": "^0.16.0",
    "turndown": "^7.2.0",
